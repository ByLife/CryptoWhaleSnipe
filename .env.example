HTTP_API=true
HTTP_PORT=3000
WEBSOCKETS_API=false
MONGO_URL=
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_HOST=
MONGO_DATABASE=

# Etherscan API V2 key (V1 endpoint is shut down)
ETH_APIKEY=
ETHPLORER_APIKEY=
HELIUS_API_KEY=

# Insider signal rule (defaults chosen from DreamBot/research backtest)
SIGNAL_MIN_WALLETS=3
SIGNAL_WINDOW_DAYS=7
SIGNAL_COOLDOWN_DAYS=30
SIGNAL_FRESH_HOURS=6
SIGNAL_MIN_BUY_USD=1000

# Copy bot (regime + copy signals + paper trading), see src/autoload/regime.ts
COPY_BOT_ENABLED=true
REGIME_STREAK_DAYS=21        # alts above their 50d average this many days in a row -> ON
REGIME_FORCE=auto            # auto | on | off (manual override to test the alerts)
COPY_MIN_ROI=0               # alert only if the buyer's own realized ROI coefficient is above this
COPY_MIN_BUY_USD=300         # smart wallet buys copied from this size
COPY_COOLDOWN_DAYS=30        # one copy signal per token per period
COPY_FRESH_MINUTES=60        # older buys are recorded but never alerted / paper traded
MIN_STORE_USD=2000           # non-smart wallets: store txs from this size (as before)
PAPER_TP_MULTIPLE=10
PAPER_MAX_HOLD_DAYS=30
PAPER_COST=0.03
# Wallet status (daily): which wallets the tx loop polls
MAX_ACTIVE_WALLETS=200
DORMANT_DAYS=180
DORMANT_MIN_CASH_USD=1000
ETHERSCAN_RPS=4
